{
  "name": "bitcoin-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bitcoin-tracker \"vitest run --config vitest.rules.config.ts\"",
    "job:mercado": "node jobs/mercado.mjs",
    "job:diario": "node jobs/diario.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "auditoria": "vitest run src/lib/__tests__/auditoria.test.ts",
    "auditoria:web": "vitest run --config scripts/auditoria/vitest.web.config.ts",
    "auditoria:vacia": "firebase emulators:exec --only auth,firestore --project demo-bitcoin-tracker \"node scripts/auditoria/vacia-emulador.mjs\""
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "decimal.js": "^10.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.11.0",
    "firebase-tools": "^15.37.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-precaching": "^7.4.1"
  }
}
