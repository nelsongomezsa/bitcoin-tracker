rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───── Helpers ─────
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return verified() && request.auth.uid == userId; }

    function esMoneda(v) { return v in ['EUR', 'USD', 'AUD']; }
    function esNumero(v) { return v is number; }
    function textoMax(v, n) { return v is string && v.size() <= n; }
    function fechaValida(f) {
      return f is string
        && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(f.split('-')[0]), int(f.split('-')[1]), int(f.split('-')[2]))
           <= request.time + duration.value(1, 'd');
    }

    // ───── Datos de mercado: lectura para logueados, escritura solo desde la cuenta de servicio (Admin SDK) ─────
    match /mercado/{doc} {
      allow read: if verified();
      allow write: if false;
    }

    // ───── Todo lo del usuario cuelga de users/{uid} ─────
    match /users/{userId} {
      function perfilValido(d) {
        return d.keys().hasOnly(['nombre', 'monedaPreferida', 'modoPrivado', 'creado', 'mostrarTrading', 'sumarTradingACartera'])
          && (!('mostrarTrading' in d) || d.mostrarTrading is bool)
          && (!('sumarTradingACartera' in d) || d.sumarTradingACartera is bool)
          && textoMax(d.nombre, 60)
          && esMoneda(d.monedaPreferida)
          && d.modoPrivado is bool
          && d.creado is timestamp;
      }
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && perfilValido(request.resource.data);
      // El borrado de cuenta lo hace el propio usuario desde el cliente.
      allow delete: if isOwner(userId);

      match /operaciones/{opId} {
        function opValida(d) {
          return d.keys().hasOnly(['tipo', 'fecha', 'cantidad', 'comision', 'precio', 'moneda', 'plataforma', 'nota', 'creado', 'editado'])
            && d.keys().hasAll(['tipo', 'fecha', 'cantidad', 'comision', 'precio', 'moneda', 'creado'])
            && d.tipo in ['compra', 'venta']
            && fechaValida(d.fecha)
            && esNumero(d.cantidad) && d.cantidad > 0 && d.cantidad < 10000000
            && esNumero(d.comision) && d.comision >= 0 && d.comision < d.cantidad
            && esNumero(d.precio) && d.precio > 0 && d.precio < 100000000
            && esMoneda(d.moneda)
            && (!('plataforma' in d) || textoMax(d.plataforma, 40))
            && (!('nota' in d) || textoMax(d.nota, 200))
            && d.creado is timestamp
            && (!('editado' in d) || d.editado is timestamp);
        }
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && opValida(request.resource.data);
        allow update: if isOwner(userId) && opValida(request.resource.data)
                      && request.resource.data.creado == resource.data.creado;
      }

      match /trades/{tradeId} {
        function precioOk(p) { return esNumero(p) && p > 0 && p < 100000000; }
        function tradeValido(d) {
          return d.keys().hasOnly(['estado', 'direccion', 'fechaInicio', 'fechaCierre', 'precioEntrada', 'precioSalida', 'moneda', 'apalancamiento', 'margenBTC', 'comisiones', 'btcGanadoManual', 'plataforma', 'nota', 'creado', 'editado'])
            && d.keys().hasAll(['estado', 'direccion', 'fechaInicio', 'precioEntrada', 'moneda', 'apalancamiento', 'creado'])
            && d.estado in ['abierto', 'cerrado']
            && d.direccion in ['largo', 'corto']
            && fechaValida(d.fechaInicio)
            && precioOk(d.precioEntrada)
            && esMoneda(d.moneda)
            && esNumero(d.apalancamiento) && d.apalancamiento >= 1 && d.apalancamiento <= 125
            && (d.estado == 'abierto' || ('fechaCierre' in d && 'precioSalida' in d))
            && (!('fechaCierre' in d) || (fechaValida(d.fechaCierre) && d.fechaCierre >= d.fechaInicio))
            && (!('precioSalida' in d) || precioOk(d.precioSalida))
            && (!('margenBTC' in d) || (esNumero(d.margenBTC) && d.margenBTC > 0 && d.margenBTC < 21000000))
            && (!('comisiones' in d) || (esNumero(d.comisiones) && d.comisiones >= 0 && d.comisiones <= 100))
            && (!('btcGanadoManual' in d) || (esNumero(d.btcGanadoManual) && d.btcGanadoManual > -21000000 && d.btcGanadoManual < 21000000))
            && (!('plataforma' in d) || textoMax(d.plataforma, 40))
            && (!('nota' in d) || textoMax(d.nota, 200))
            && d.creado is timestamp
            && (!('editado' in d) || d.editado is timestamp);
        }
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && tradeValido(request.resource.data);
        allow update: if isOwner(userId) && tradeValido(request.resource.data)
                      && request.resource.data.creado == resource.data.creado;
      }

      match /plan/config {
        function planValido(d) {
          return d.keys().hasOnly(['capital', 'nivelesClave', 'dca', 'objetivos'])
            && esNumero(d.capital) && d.capital >= 0 && d.capital < 1000000000
            && d.nivelesClave is list && d.nivelesClave.size() <= 20
            && d.dca is map
            && d.dca.keys().hasOnly(['inicio', 'porcentajeSemanal', 'semanas', 'precioInicio', 'monedaInicio'])
            && (!('inicio' in d.dca) || fechaValida(d.dca.inicio))
            && esNumero(d.dca.porcentajeSemanal) && d.dca.porcentajeSemanal >= 0 && d.dca.porcentajeSemanal <= 100
            && d.dca.semanas is int && d.dca.semanas >= 0 && d.dca.semanas <= 520
            && (!('precioInicio' in d.dca) || (esNumero(d.dca.precioInicio) && d.dca.precioInicio > 0))
            && (!('monedaInicio' in d.dca) || esMoneda(d.dca.monedaInicio))
            && (!('objetivos' in d) || (d.objetivos is map && d.objetivos.keys().size() <= 10));
        }
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && planValido(request.resource.data);
      }

      match /avisos/config {
        function generalValido(g) {
          return g is map
            && g.keys().hasOnly(['zona', 'silencioDesde', 'silencioHasta', 'silencioActivo', 'limiteDiario', 'pausadoHasta', 'moneda', 'horaResumen'])
            && (!('zona' in g) || textoMax(g.zona, 64))
            && (!('silencioDesde' in g) || (g.silencioDesde is int && g.silencioDesde >= 0 && g.silencioDesde <= 23))
            && (!('silencioHasta' in g) || (g.silencioHasta is int && g.silencioHasta >= 0 && g.silencioHasta <= 23))
            && (!('silencioActivo' in g) || g.silencioActivo is bool)
            && (!('limiteDiario' in g) || (g.limiteDiario is int && g.limiteDiario >= 1 && g.limiteDiario <= 100))
            && (!('pausadoHasta' in g) || (esNumero(g.pausadoHasta) && g.pausadoHasta >= 0))
            && (!('moneda' in g) || esMoneda(g.moneda))
            && (!('horaResumen' in g) || (g.horaResumen is int && g.horaResumen >= 0 && g.horaResumen <= 23));
        }
        function avisosValidos(d) {
          return d.keys().hasOnly(['ajustes', 'tokens', 'resumen', 'general', 'alertas', 'seguidas', 'telegram', 'historialLeidoHasta'])
            && d.ajustes is map && d.ajustes.keys().size() <= 60
            && (!('tokens' in d) || (d.tokens is list && d.tokens.size() <= 10))
            && (!('resumen' in d) || d.resumen is map)
            && (!('general' in d) || generalValido(d.general))
            && (!('alertas' in d) || (d.alertas is list && d.alertas.size() <= 20))
            && (!('seguidas' in d) || (d.seguidas is list && d.seguidas.size() <= 30))
            && (!('telegram' in d) || (d.telegram is map && d.telegram.keys().hasOnly(['desconectar'])))
            && (!('historialLeidoHasta' in d) || d.historialLeidoHasta is timestamp);
        }
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && avisosValidos(request.resource.data);
      }

      // Estado interno del job (lo ya avisado, Telegram vinculado…): el dueño lo lee y puede borrarlo, solo el backend lo escribe.
      match /avisos/estado {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }

      // Aviso de prueba: el cliente deja una marca de tiempo (máximo una cada 5 minutos) y el job lo envía.
      match /avisos/prueba {
        function tsValido(d) { return d.keys().hasOnly(['ts']) && d.ts == request.time; }
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && tsValido(request.resource.data);
        allow update: if isOwner(userId) && tsValido(request.resource.data)
                      && request.time > resource.data.ts + duration.value(5, 'm');
      }

      // Historial de avisos (30 días): solo lo escribe el job. El dueño lo lee y puede borrarlo (borrado de cuenta).
      match /historial/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }

      // Dispositivos desde los que ha iniciado sesión (sin IP ni huella).
      match /dispositivos/{id} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['creado', 'navegador', 'procesado'])
          && request.resource.data.creado == request.time
          && textoMax(request.resource.data.navegador, 40)
          && request.resource.data.procesado is bool;
        allow update: if false;
      }
    }

    // Códigos de vinculación con Telegram: un solo uso, 15 minutos. Solo se puede crear el propio.
    match /vinculos/{codigo} {
      allow create: if verified()
        && codigo.matches('^[A-Z0-9]{8,16}$')
        && request.resource.data.keys().hasOnly(['uid', 'expira'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.expira is timestamp
        && request.resource.data.expira > request.time
        && request.resource.data.expira <= request.time + duration.value(15, 'm');
      allow delete: if verified() && resource.data.uid == request.auth.uid;
      allow read, update: if false;
    }

    // Cualquier otra ruta, denegada.
    match /{document=**} { allow read, write: if false; }
  }
}
